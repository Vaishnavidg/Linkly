# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/linkly

# Secret used to sign login tokens (use a long random string).
# If omitted, MONGO_URI is used instead -- set this in production.
JWT_SECRET=

# Port to listen on (default 8000)
PORT=8000

# Comma-separated browser origins allowed by CORS
# (default: https://linkly-olive.vercel.app,http://localhost:5173)
CLIENT_ORIGINS=http://localhost:5173
