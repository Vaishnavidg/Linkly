# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/linkly

# Secret used to sign login tokens (use a long random string).
# If omitted, MONGO_URI is used instead -- set this in production.
JWT_SECRET=

# Port to listen on (default 8000)
PORT=8000

# Comma-separated browser origins allowed by CORS (no trailing slash).
# If set, this REPLACES the built-in defaults, so list every frontend URL:
# your custom domain, each Vercel alias you use, and localhost for development.
CLIENT_ORIGINS=https://linkly.vaishnavidg.com,https://linkly-olive.vercel.app,https://linkly-live.vercel.app,http://localhost:5173
